{
  "permissions": {
    "allow": [
      "mcp__Google_Drive__download_file_content",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__list_recent_files"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/montaj_prompt.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/montaj_guard.py\"" }
        ]
      }
    ]
  }
}
