# Bu faylı deploy/.env kimi kopyalayın. deploy/.env repoya YAZILMAMALIDIR (.gitignore).
# Domen yoxdursa: serverin IP-si 1.2.3.4 olarsa -> 1-2-3-4.sslip.io
MONTAJ_DOMAIN=montaj.example.com
MONTAJ_PASSWORD=uzun-və-unikal-parol
# Cookie imzası üçün təsadüfi dəyər (məs. `openssl rand -hex 32`)
MONTAJ_SECRET=
# İstəyə bağlı: panel daxilində AI storyboard/caption (console.anthropic.com)
ANTHROPIC_API_KEY=
